# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# SUPABASE AUTH (Khusus Autentikasi Halaman Panitia Cetak Massal)
# -------------------------------------------------------------
# Dapatkan dari Supabase Dashboard: Project Settings > API
# PENTING: Hanya gunakan Project URL dan anon key (publishable key).
# DILARANG KERAS menaruh service_role key di sini!
VITE_SUPABASE_URL="ISI_PROJECT_URL_DI_SINI"
VITE_SUPABASE_ANON_KEY="ISI_ANON_KEY_DI_SINI"
